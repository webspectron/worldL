PORT=5000

# Generate both of these fresh for a real deployment — never reuse the sample values below.
# Set them in your local .env (gitignored) and again in the host's environment variables.
# Never commit real values.
#
# To set/change the admin password (run in the project folder; the password is typed at a
# hidden prompt, so it never lands in a file or your shell history). Windows PowerShell:
#   $s = Read-Host "New admin password" -AsSecureString
#   $env:NEW_ADMIN_PW = [Runtime.InteropServices.Marshal]::PtrToStringAuto([Runtime.InteropServices.Marshal]::SecureStringToBSTR($s))
#   node -e "console.log(require('bcryptjs').hashSync(process.env.NEW_ADMIN_PW, 12))"
#   Remove-Item Env:NEW_ADMIN_PW; Remove-Variable s
# then paste the output (starts with $2b$12$) as ADMIN_PASSWORD_HASH, unquoted.
#
# To generate a session secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash-see-instructions-above
SESSION_SECRET=replace-with-a-random-64-char-hex-string

# No longer does anything: demo data was removed before launch. Keep it false (or unset).
SEED_DEMO_DATA=false

# Database: the default file is data/app.db (relative to the app folder). A database file
# with any other name in that folder is ignored and a warning is logged at startup.
#
# CRITICAL on a real deployment: if your host wipes files that aren't tracked by git on every
# deploy (some do, as part of a clean checkout), the database silently disappears the moment
# you push new code — since it MUST be gitignored (a live database can't be committed).
# If your host provides any storage path described as persistent / surviving redeploys, set
# DB_PATH to a .db file inside it (e.g. /home/yourapp/persistent-storage/app.db).
# Leave unset for local dev, or once you've confirmed your host does NOT wipe untracked files.
# DB_PATH=/absolute/path/to/persistent-storage/app.db
